; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Cubarmy Spire"
run/main_scene="res://ui/Root.tscn"
config/features=PackedStringArray("4.2", "Forward Plus")
config/icon="res://assets/images/logo.png"

[autoload]

SceneManager="*res://scripts/scene_manager.gd"
Faction="*res://scripts/faction.gd"
GameData="*res://scripts/game_data.gd"
IconDatabase="*res://scripts/icon_database.gd"
RollManager="*res://scripts/roll_manager.gd"
SaveManager="*res://scripts/save_manager.gd"
RunState="*res://scripts/run_state.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[file_customization]

folder_colors={
"res://assets/": "pink",
"res://data/": "purple",
"res://objects/": "yellow",
"res://scenes/": "blue",
"res://scripts/": "gray",
"res://ui/": "green"
}

[input]

battle_zoom_in={
"deadzone": 0.5,
